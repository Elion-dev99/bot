# Discord Developer Portal で作成した Bot のトークン（必須）
DISCORD_TOKEN=your_bot_token_here

# Application ID（Client ID）— スラッシュコマンド登録・招待リンクに使用（Railway でも必須）
DISCORD_CLIENT_ID=1533753341639786607

# 推奨: サーバーID — スラッシュコマンドを即時反映（Railway Variables に設定）
# DISCORD_GUILD_ID=1533753990196625461

# Railway Volume のマウント先（Volume を /data に付けた場合）
# DATA_DIR=/data

# 任意: 反応するチャンネルIDをカンマ区切りで指定（未設定なら全チャンネル）
# ALLOWED_CHANNEL_IDS=1533753991085821965
