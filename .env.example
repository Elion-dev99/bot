# Discord Developer Portal で作成した Bot のトークン（必須）
DISCORD_TOKEN=your_bot_token_here

# Application ID（Client ID）— 招待リンク生成・スラッシュコマンド登録に使用
DISCORD_CLIENT_ID=1533753341639786607

# 任意: 指定するとそのサーバーだけにスラッシュコマンドを即時登録（開発向け）
# DISCORD_GUILD_ID=123456789012345678

# 任意: 反応するチャンネルIDをカンマ区切りで指定（未設定なら全チャンネル）
# ALLOWED_CHANNEL_IDS=123456789012345678,987654321098765432
